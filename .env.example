# Hugging Face Configuration (Free Serverless Inference API)
# Get your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_free_token_here
# Recommended free models:
# - meta-llama/Llama-3.2-3B-Instruct
# - mistralai/Mistral-7B-Instruct-v0.3
# - facebook/bart-large-cnn
# - Qwen/Qwen2.5-7B-Instruct
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Google Email Configuration
# Mode can be 'oauth' (recommended, using credentials.json) or 'imap' (using app password)
GMAIL_AUTH_MODE=oauth

# If using IMAP mode:
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Notifications & Messages Configuration
# Set to 'true' to trigger macOS desktop notifications
ENABLE_DESKTOP_NOTIFICATIONS=true

# Optional: Set an Apple ID or phone number (e.g. +1234567890) to send summaries via Apple Messages app
# Leave empty if you only want desktop notification banners
MESSAGES_RECIPIENT=

# General Settings
MAX_EMAILS=5
ONLY_UNREAD=true
